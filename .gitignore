# OAuth client secrets. client_secret.json holds a live Google client secret
# and was not matched by the .env rules above, so it would have been committed.
client_secret.json
client_secret*.json
**/google_signup_login/client_secret.json
*service-account*.json

# ---- Shared uploads (user-generated; should not live in git) ----
user_app/uploads/
admin_app/uploads/

