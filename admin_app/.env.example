# ============================================================
# Environment variables template.
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# NEVER commit the real .env (it is git-ignored).
# ============================================================

# ---- Flask / security ----
SECRET_KEY=change-me-to-a-long-random-string
CSRF_SESSION_KEY=change-me-to-a-long-random-string
ENROLL_SECRET_KEY=change-me-to-a-long-random-string
DOWNLOAD_SECRET_KEY=change-me-to-a-long-random-string
TEST_TOKEN_SECRET=change-me-to-a-long-random-string

# ---- Database (MySQL) ----
DATABASE_HOST=localhost
DATABASE_USER=root
DATABASE_PASSWORD=your-db-password
DATABASE_NAME=your-db-name

# ---- Email (SMTP) ----
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# ---- Payments (Razorpay) ----
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_SECRET=your-razorpay-secret

# ---- Google OAuth ----
CLIENT_ID=your-google-client-id
CLIENT_SECRET=your-google-client-secret
REDIRECT_URI=http://127.0.0.1:5000/callback

# ---- Optional infrastructure ----
# If set, enables server-side Redis sessions + Socket.IO message queue.
REDIS_URL=redis://localhost:6379/0
# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ---- Uploaded files ----
# Where uploaded files are kept; defaults to the uploads folder inside this app.
# Every file is also written to the database, which is how the student app
# receives it.
# UPLOAD_BASE=/var/data/spp_admin_uploads
