# ============================================================
# Environment variables template.
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# NEVER commit the real .env (it is git-ignored).
# ============================================================

# ---- Flask / security ----
SECRET_KEY=change-me-to-a-long-random-string
CSRF_SESSION_KEY=change-me-to-a-long-random-string
ENROLL_SECRET_KEY=change-me-to-a-long-random-string
DOWNLOAD_SECRET_KEY=change-me-to-a-long-random-string
TEST_TOKEN_SECRET=change-me-to-a-long-random-string

# ---- Database (MySQL) ----
DATABASE_HOST=localhost
DATABASE_USER=root
DATABASE_PASSWORD=your-db-password
DATABASE_NAME=your-db-name

# ---- Email (SMTP) ----
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# ---- Payments (Razorpay) ----
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_SECRET=your-razorpay-secret
# Enables the server-to-server webhook that activates premium subscriptions
# even when the buyer's browser dies after paying. Create the webhook in the
# Razorpay dashboard pointing at /practice-coding/api/subscribe/webhook.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ---- Google OAuth ----
CLIENT_ID=your-google-client-id
CLIENT_SECRET=your-google-client-secret
REDIRECT_URI=http://127.0.0.1:5002/callback

# ---- Deployment ----
# Set to "production" on the live server. Turns on ProxyFix (correct client
# IPs and https detection behind the reverse proxy), secure session cookies,
# and https link generation. Render/PythonAnywhere/gunicorn are auto-detected,
# but setting this explicitly is the reliable switch.
APP_ENV=production
# Public site URL, used in emailed links and Socket.IO allowed origins.
WEBSITE_URL=https://your-domain.example
# Comma-separated Socket.IO origins; defaults to WEBSITE_URL + localhost.
# SOCKETIO_ORIGINS=https://your-domain.example
# Where uploaded files are kept; defaults to the uploads folder inside this app.
# Files the admin uploads arrive through the database and are copied here on
# first use. Student recordings are written here: on hosts with ephemeral
# filesystems, or with several student servers, point this at a persistent
# disk they all share.
# UPLOAD_BASE=/var/data/spp_student_uploads
# MySQL pool size per worker process (default 16, max 32).
# DB_POOL_SIZE=16

# ---- Optional infrastructure ----
# If set, enables server-side Redis sessions, shared rate limits across
# workers, and the Socket.IO message queue. Strongly recommended whenever
# more than one worker process runs.
REDIS_URL=redis://localhost:6379/0
# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ---- Scale / throughput ----
# Email is queued and sent by background workers, so signup, OTP, password
# reset and enrolment return immediately instead of waiting on SMTP.
# Set EMAIL_ASYNC=0 to send inline again (useful when debugging delivery).
EMAIL_ASYNC=1
# Domain used in the Message-ID header. Set it to your real sending domain to
# skip a reverse-DNS lookup that costs seconds per email on some hosts.
EMAIL_MSGID_DOMAIN=
EMAIL_WORKERS=4
EMAIL_QUEUE_MAX=5000

# Gunicorn worker processes. Keep this at 1 unless REDIS_URL is set: rate
# limits, Socket.IO events and sessions only cross workers through Redis.
# With Redis, start at (2 x CPU cores).
WEB_CONCURRENCY=1

# Connections per worker. Keep (WEB_CONCURRENCY x DB_POOL_SIZE) below the
# server's max_connections, leaving headroom for the admin app.
DB_POOL_SIZE=20

# Code judge capacity (Docker sandbox). JUDGE_MAX_PARALLEL containers run at once
# per web process (default: half the CPU cores); up to JUDGE_MAX_WAITING more
# runs queue for at most JUDGE_QUEUE_WAIT seconds, then get a "judge is busy"
# answer instead of starting a container. Watch /practice-coding/api/judge/health.
JUDGE_MAX_PARALLEL=4
JUDGE_MAX_WAITING=16
JUDGE_QUEUE_WAIT=25

DB_POOL_WAIT=15
REDIS_POOL_SIZE=64
RATELIMIT_ENABLED=1
SESSION_FILE_THRESHOLD=200000
CPU_QUOTA=1
DOCKER_READONLY_ROOTFS=true
DOCKER_RUN_AS_NONROOT=true
JUDGE_FILE_LIMIT_MB=32
JUDGE_STDOUT_LIMIT_BYTES=4194304
JUDGE_CASE_OUTPUT_LIMIT_BYTES=2097152
FORWARDED_ALLOW_IPS=127.0.0.1

# Worker engine under gunicorn: gevent (default) or threading. With threading,
# GUNICORN_THREADS sets the threads per worker.
SPP_ASYNC_MODE=gevent
GUNICORN_THREADS=32

# Where programs are judged. local = Docker on this web server. queue = jobs go
# to Redis and are run by judge_worker.py on separate judge hosts (needs
# REDIS_URL). JUDGE_QUEUE_MAX is the most jobs allowed to wait in the queue.
JUDGE_MODE=local
JUDGE_QUEUE_MAX=500

# Answers that could not be graded because the judge was busy are graded later
# by a background job. Set PENDING_GRADER_JOB=0 to switch it off on a server.
PENDING_GRADER_JOB=1
PENDING_GRADER_INTERVAL=20

# SQL coding questions run as a separate read-only MySQL account that the app
# creates by itself. Change the password on a real server. SQL_SANDBOX_PARALLEL
# is how many student queries one worker runs at once; more wait up to
# SQL_SANDBOX_WAIT seconds and are then asked to try again.
SQL_SANDBOX_USER=cj_sandbox
SQL_SANDBOX_PASS=change-this-password
SQL_SANDBOX_PARALLEL=8
SQL_SANDBOX_WAIT=10
