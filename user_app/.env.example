# ============================================================
# Environment variables template.
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# NEVER commit the real .env (it is git-ignored).
# ============================================================

# ---- Flask / security ----
SECRET_KEY=change-me-to-a-long-random-string
CSRF_SESSION_KEY=change-me-to-a-long-random-string
ENROLL_SECRET_KEY=change-me-to-a-long-random-string
DOWNLOAD_SECRET_KEY=change-me-to-a-long-random-string
TEST_TOKEN_SECRET=change-me-to-a-long-random-string

# ---- Database (MySQL) ----
DATABASE_HOST=localhost
DATABASE_USER=root
DATABASE_PASSWORD=your-db-password
DATABASE_NAME=your-db-name

# ---- Email (SMTP) ----
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# ---- Payments (Razorpay) ----
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_SECRET=your-razorpay-secret
# Enables the server-to-server webhook that activates premium subscriptions
# even when the buyer's browser dies after paying. Create the webhook in the
# Razorpay dashboard pointing at /practice-coding/api/subscribe/webhook.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ---- Google OAuth ----
CLIENT_ID=your-google-client-id
CLIENT_SECRET=your-google-client-secret
REDIRECT_URI=http://127.0.0.1:5002/callback

# ---- Deployment ----
# Set to "production" on the live server. Turns on ProxyFix (correct client
# IPs and https detection behind the reverse proxy), secure session cookies,
# and https link generation. Render/PythonAnywhere/gunicorn are auto-detected,
# but setting this explicitly is the reliable switch.
APP_ENV=production
# Public site URL, used in emailed links and Socket.IO allowed origins.
WEBSITE_URL=https://your-domain.example
# Comma-separated Socket.IO origins; defaults to WEBSITE_URL + localhost.
# SOCKETIO_ORIGINS=https://your-domain.example
# Where user uploads are stored; defaults to ../shared_uploads next to the app.
# Point at a persistent disk on hosts with ephemeral filesystems.
# UPLOAD_BASE=/var/data/shared_uploads
# MySQL pool size per worker process (default 16, max 32).
# DB_POOL_SIZE=16

# ---- Optional infrastructure ----
# If set, enables server-side Redis sessions, shared rate limits across
# workers, and the Socket.IO message queue. Strongly recommended whenever
# more than one worker process runs.
REDIS_URL=redis://localhost:6379/0
# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
