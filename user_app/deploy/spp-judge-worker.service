[Unit]
Description=ShyamPracticePaper judge worker
After=network.target docker.service

[Service]
User=spp
SupplementaryGroups=docker
WorkingDirectory=/srv/user_app
EnvironmentFile=/srv/user_app/.env
Environment=JUDGE_MODE=queue
ExecStart=/srv/user_app/.venv/bin/python judge_worker.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
