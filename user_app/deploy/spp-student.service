[Unit]
Description=ShyamPracticePaper student app
After=network.target redis-server.service

[Service]
User=spp
WorkingDirectory=/srv/user_app
EnvironmentFile=/srv/user_app/.env
Environment=APP_ENV=production
Environment=BIND=127.0.0.1:5002
ExecStart=/srv/user_app/.venv/bin/gunicorn -c gunicorn.conf.py wsgi:app
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
